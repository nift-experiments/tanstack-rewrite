    "@tanstack/highlight": "1.0.0",
    "@tanstack/markdown": "1.0.0",
    "@tanstack/react-router": "1.170.41",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.5.0",
    "zod": "4.3.6",
    "zustand": "5.0.12"
