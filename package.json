{
  "name": "tanstack-rewrite",
  "private": true,
  "type": "module",
  "description": "Exact-product Nift rewrite experiment; representative implementation in progress",
  "scripts": {
    "reference:inventory": "python3 scripts/inventory-reference.py",
    "reference:capture": "node scripts/reference/capture.mjs",
    "parser:build": "node scripts/compile-parser.mjs",
    "proof:parser": "npm run parser:build && node scripts/proof-parser.mjs",
    "proof:authority:build": "npm run parser:build && node scripts/proof-authority-build.mjs",
    "proof:authority:browser": "node scripts/proof-authority-browser.mjs",
    "proof:document": "node scripts/proof-document.mjs",
    "proof:codeblock": "node scripts/proof-codeblock.mjs",
    "proof:article-controls": "node scripts/proof-article-controls.mjs",
    "proof:session": "node scripts/proof-session.mjs",
    "proof:auth": "node scripts/proof-auth.mjs",
    "proof:article:pixels": "node scripts/proof-article-pixels.mjs && python3 scripts/verify-article-pixels.py",
    "proof:real-literal": "node scripts/proof-real-literal.mjs",
    "proof:file-tabs": "node scripts/proof-file-tabs.mjs",
    "proof:package-controls": "node scripts/proof-package-controls.mjs",
    "proof:framework-preferences": "node scripts/proof-framework-preferences.mjs",
    "proof:api-protocol": "node scripts/proof-api-protocol.mjs",
    "proof:api-imports": "node scripts/audit-api-imports.mjs",
    "proof:mermaid-island": "node scripts/proof-mermaid-island.mjs",
    "proof:publication-boundary": "node scripts/proof-publication-boundary.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/highlight": "1.0.0",
    "@tanstack/markdown": "1.0.0",
    "@tanstack/react-router": "1.170.41",
    "mermaid": "11.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.5.0",
    "zod": "4.3.6",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "esbuild": "0.27.4"
  }
}
